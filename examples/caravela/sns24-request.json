      "role": "user",
      "content": "Como peço exames perto de mim na App SNS 24? Explica o percurso, sem aceder à minha conta."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "ecidadao__sns24_service_guidance",
        "description": "Explica percursos oficiais para consultas, exames, renovação de medicação habitual e referenciações no Portal/App SNS 24, em PT ou EN. Não consulta contas, vagas ou dados clínicos; não faz triagem nem submete pedidos. Não envie dados pessoais.",
