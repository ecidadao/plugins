          "type": "object",
          "required": [
            "service"
          ],
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "enum": [
                "appointments",
                "exams",
                "medication",
                "referrals"
              ]
            },
            "channel": {
              "default": "both",
              "type": "string",
              "enum": [
                "portal",
                "app",
                "both"
              ]
            },
            "language": {
              "default": "pt",
              "type": "string",
              "enum": [
                "pt",
                "en"
              ]
            }
          }
        }
      }
    }
  ],
  "tool_choice": {
    "type": "function",
    "function": {
      "name": "ecidadao__sns24_service_guidance"
    }
  }
